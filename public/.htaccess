# Configuration du serveur Apache d'Infomaniak (copiée telle quelle dans dist/ au build)
# Fusion : règles d'origine d'Infomaniak + règles du portfolio.
# Le passage forcé en HTTPS se règle dans le Manager Infomaniak, pas ici
# (une redirection ici peut boucler derrière leur proxy).

# --- Règles d'origine Infomaniak : compression ---
SetOutputFilter DEFLATE
AddOutputFilterByType DEFLATE "application/atom+xml" "application/javascript" "application/json" "application/ld+json" "application/manifest+json" "application/rdf+xml" "application/rss+xml" "application/schema+json" "application/vnd.geo+json" "application/vnd.ms-fontobject" "application/x-font-ttf" "application/x-javascript" "application/x-web-app-manifest+json" "application/xhtml+xml" "application/xml" "font/eot" "font/opentype" "image/bmp" "image/svg+xml" "image/vnd.microsoft.icon" "image/x-icon" "text/cache-manifest" "text/css" "text/html" "text/javascript" "text/plain" "text/vcard" "text/vnd.rim.location.xloc" "text/vtt" "text/x-component" "text/x-cross-domain-policy" "text/xml"

# --- Règles d'origine Infomaniak : protection Git ---
# SECTION BEGIN GIT PROTECTION
RedirectMatch 404 /\.git
# SECTION END GIT PROTECTION

# --- Portfolio ---

# Fichier de suivi créé par la GitHub Action de déploiement : inutile au public
RedirectMatch 404 /\.ftp-deploy-sync-state\.json$

# Page d'erreur personnalisée
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Fichiers de /_astro/ : leur nom contient un hash qui change à chaque modification,
  # on peut donc les garder en cache 1 an sans risque (sobriété : pas de re-téléchargement)
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Sécurité de base
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
