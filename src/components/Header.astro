---
// En-tête + navigation. Menu hamburger en dessous de md (768px).
const liens = [
  { href: '/projets/', label: '[projets]' },
  { href: '/a-propos/', label: '[à_propos]' },
  { href: '/contact/', label: '[contact]' },
];

// Normalise pour comparer "/contact" et "/contact/"
const actuel = Astro.url.pathname.replace(/\/?$/, '/');
const estActif = (href: string) => actuel === href || actuel.startsWith(href);
---

<header class="sticky top-0 z-40 border-b-[6px] border-noir bg-creme">
  <div class="flex items-center justify-between gap-6 px-4 py-5 md:px-7">
    <a href="/" class="font-mono text-lg font-bold uppercase text-rouge md:text-2xl">
      [Yanis_Forster // root]
    </a>

    <button
      id="menu-bouton"
      type="button"
      class="font-mono font-bold uppercase md:hidden"
      aria-expanded="false"
      aria-controls="menu"
    >
      [menu]
    </button>

    <nav id="menu" aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex flex-col gap-4 font-mono text-xl font-bold uppercase md:flex-row md:gap-10 md:text-2xl">
        {liens.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={estActif(href) ? 'page' : undefined}
              class="hover:text-rouge aria-[current=page]:text-rouge"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="hidden font-mono text-2xl font-bold uppercase xl:block">
      Statut : recherche de stage
    </p>
  </div>
</header>

<script>
  // Ouvre / ferme le menu mobile et tient aria-expanded à jour pour les lecteurs d'écran
  const bouton = document.getElementById('menu-bouton');
  const menu = document.getElementById('menu');

  if (bouton && menu) {
    const fermer = () => {
      bouton.setAttribute('aria-expanded', 'false');
      bouton.textContent = '[menu]';
      menu.classList.add('hidden');
    };

    bouton.addEventListener('click', () => {
      const ouvert = bouton.getAttribute('aria-expanded') === 'true';
      if (ouvert) return fermer();
      bouton.setAttribute('aria-expanded', 'true');
      bouton.textContent = '[fermer]';
      menu.classList.remove('hidden');
      menu.querySelector('a')?.focus();
    });

    // Échap ferme le menu et rend le focus au bouton
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && bouton.getAttribute('aria-expanded') === 'true') {
        fermer();
        bouton.focus();
      }
    });
  }
</script>
