---
// Carte d'un projet, en deux mises en page :
// - "compacte" : deux cartes côte à côte, tag posé sur la bordure
// - "large"    : image à gauche, texte à droite
// Avec details (page Projets), la carte affiche aussi la stack et le lien
// « voir l'étude de cas ».
//
// Survol : la carte se décale et une ombre rouge pleine apparaît derrière,
// comme la boîte de l'intro. Même effet au clavier (focus-within).
//
// Transition : l'image porte un view-transition-name unique par projet.
// Si la page du projet donne le même nom à son image principale,
// le navigateur fait grandir l'image de la carte jusqu'à sa place.
import { Image } from 'astro:assets';
import type { Projet } from '../data/projets';

interface Props {
  projet: Projet;
  variante?: 'compacte' | 'large';
  details?: boolean;
}

const { projet, variante = 'compacte', details = false } = Astro.props;
const lien = `/projets/${projet.slug}/`;
const nomTransition = `projet-${projet.slug}`;
const libelleCategorie = `[${projet.categorie.replace(' ', '_')}]`;
---

<article
  data-categorie={projet.categorie}
  class:list={[
    'carte-projet relative flex h-full flex-col border-4 border-noir bg-creme md:border-[5px]',
    variante === 'large'
      ? 'gap-6 p-5 md:grid md:grid-cols-[3fr_2fr] md:items-center md:gap-10 md:p-6'
      : 'p-5 pt-9 md:p-6 md:pt-10',
  ]}
>
  {variante === 'compacte' && (
    <span class="tag absolute -top-4 left-5 text-petit">{libelleCategorie}</span>
  )}

  <Image
    src={projet.image}
    alt={projet.alt}
    widths={[600, 1200]}
    sizes={variante === 'large' ? '(min-width: 768px) 60vw, 100vw' : '(min-width: 768px) 45vw, 100vw'}
    class:list={[
      'w-full border-[3px] border-noir object-cover',
      variante === 'compacte' ? 'aspect-[2.4/1]' : 'aspect-[2/1]',
    ]}
    style={`view-transition-name: ${nomTransition}; object-position: ${variante === 'compacte' ? (projet.cadrage ?? 'top') : 'top'}`}
  />

  <div class="flex flex-1 flex-col">
    {variante === 'large' && <span class="tag self-start text-petit">{libelleCategorie}</span>}

    <h3 class="mt-6 font-display text-[clamp(2.25rem,3.33vw,3rem)] leading-none uppercase">
      <!-- Le lien couvre toute la carte grâce à son ::after -->
      <a href={lien} class="after:absolute after:inset-0 after:content-['']">
        {projet.titre}
      </a>
    </h3>

    <p class="label-mono mt-2 text-label">{projet.sousTitre}</p>

    <p class="mt-3 text-petit leading-relaxed">{projet.description}</p>

    {details && (
      <>
        <p class="mt-3 font-mono text-xs">{projet.stack.join(' · ')}</p>
        <span class="label-mono mt-auto pt-5 text-meta" aria-hidden="true">
          [voir_l'étude_de_cas] →
        </span>
      </>
    )}
  </div>
</article>

<style>
  .carte-projet {
    transition:
      translate 0.2s ease,
      box-shadow 0.2s ease;
  }

  /* Survol à la souris, ou focus clavier sur le lien de la carte */
  .carte-projet:hover,
  .carte-projet:focus-within {
    translate: -6px -6px;
    box-shadow: 10px 10px 0 0 var(--color-rouge);
  }

  /* Le contour de focus suit toute la carte plutôt que le seul titre */
  .carte-projet:has(a:focus-visible) {
    outline: 3px solid var(--color-rouge);
    outline-offset: 6px;
  }
  .carte-projet a:focus-visible {
    outline: none;
  }
</style>
