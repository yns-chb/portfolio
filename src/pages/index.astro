---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import CarteProjet from '../components/CarteProjet.astro';
import { projets } from '../data/projets';


const [premier, deuxieme, ...suivants] = projets;

const competences = [
  { titre: 'développement', outils: ['astro', 'javascript', 'html / css', 'wordpress'] },
  { titre: 'data', outils: ['sqlite', 'pocketbase', 'modélisation mcd/mld'] },
  { titre: 'création', outils: ['figma', 'affinity', 'davinci resolve'] },
];
---

<BaseLayout
  title="Accueil"
  description="Portfolio de Yanis Forster, étudiant en BUT MMI parcours développement web, à la recherche d'un stage."
>
  <Intro slot="avant" />

  
  <section class="flex flex-col gap-6 border-b-[6px] border-noir px-4 pt-12 pb-3 md:flex-row md:items-end md:justify-between md:px-7 md:pt-16 md:pb-4">
    <h1 class="text-accueil">Yanis<br />Forster</h1>
    <p class="font-mono md:pb-4 md:text-right">
      <span class="block text-label font-bold text-rouge uppercase">BUT MMI</span>
      <span class="curseur block text-meta">développement web</span>
    </p>
  </section>

 
  <section class="px-4 pt-6 pb-20 md:px-7" aria-labelledby="titre-projets">
    <h2 id="titre-projets" class="sr-only">Projets à la une</h2>

   

    <div data-liste-projets class="mt-12 grid gap-12 md:grid-cols-2 md:gap-x-12 md:gap-y-12">
      <CarteProjet projet={premier} variante="compacte" />
      <CarteProjet projet={deuxieme} variante="compacte" />
      {
        suivants.map((projet) => (
          <div data-item-projet class="md:col-span-2">
            <CarteProjet projet={projet} variante="large" />
          </div>
        ))
      }
    </div>

    <p class="mt-12">
      <a href="/projets/" class="label-mono text-label hover:underline">[tous_les_projets] →</a>
    </p>
  </section>

 
  <section class="px-4 pb-20 md:px-7" aria-labelledby="titre-competences">
    <h2 id="titre-competences" class="border-t-[10px] border-noir pt-4 text-titre-2 md:text-titre">
      Compétences
    </h2>

    <div class="mt-6 grid gap-10 bg-noir px-6 py-10 text-creme md:grid-cols-3 md:px-16 md:py-14">
      {
        competences.map((bloc) => (
          <div>
            <h3 class="font-mono text-label font-bold text-rouge-clair uppercase">&gt; {bloc.titre}</h3>
            <ul class="mt-5 flex flex-wrap gap-3">
              {bloc.outils.map((outil) => (
                <li class="border-2 border-creme px-2 py-1 font-mono text-petit font-bold uppercase">{outil}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
