---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas.">
  <section class="px-4 py-24 font-mono md:px-7">
    <h1 class="text-accueil">404</h1>
    <p class="label-mono curseur mt-6 text-label">
      &gt; erreur : page introuvable
    </p>
    <a href="/" class="mt-10 inline-block font-bold underline hover:text-rouge"
      >[retour_à_l'accueil]</a
    >
  </section>
</BaseLayout>
